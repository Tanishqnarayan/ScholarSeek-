# Copy to .env and fill in real values. Never commit .env.
DB_NAME=mini_search_engine
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=django-insecure-change-me-for-production
DJANGO_DEBUG=True
# Set to 1 to use local sqlite instead of MySQL (useful for quick eval without MySQL)
USE_SQLITE=0
